# Connexion à la base de données MySQL (utilisateur applicatif à droits limités)
DATABASE_URL="mysql://chatop_user:CHANGE_ME@localhost:3306/chatop_db"

# Secret utilisé pour signer les tokens JWT (chaîne longue et aléatoire)
JWT_SECRET="change_me_with_a_long_random_secret"

# URL publique du serveur (utilisée pour construire l'URL des images uploadées)
APP_URL="http://localhost:3001"
